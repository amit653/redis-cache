--in redis.conf
# RDB snapshotting
save 900 1     # save after 1 change in 900 seconds
save 300 10    # save after 10 changes in 300 seconds
save 60 10000  # save after 10000 changes in 60 seconds

# AOF logging
appendonly yes
appendfsync everysec

-- redis layout
user:1 hash with 3 fields:
[user:1] → Hash object
   └─ listpack:
       "name" → "Amit"
       "age"  → "30"
       "city" → "delhi"

for hundred of fields,redis would switch to dict encoding
[user:1] → Hash object
   └─ dict:
       { "name":"Amit", "age":"30", "city":"delhi", ... }

